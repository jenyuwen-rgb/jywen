{
  "headers": [
    {
      "source": "/(.*\\.html|/)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/full",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/data_buckets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/static/db_parts/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/static/(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/256split.html"
    },
    {
      "source": "/index.html",
      "destination": "/256split.html"
    },
    {
      "source": "/full",
      "destination": "/256split.html"
    },
    {
      "source": "/256split",
      "destination": "/256split.html"
    },
    {
      "source": "/athlete/:name",
      "destination": "/athletes/:name.html"
    },
    {
      "source": "/athletes/:name",
      "destination": "/athletes/:name.html"
    },
    {
      "source": "/card/:name/:stroke/:dist",
      "destination": "/card.html"
    },
    {
      "source": "/card/:name/:stroke",
      "destination": "/card.html"
    },
    {
      "source": "/card/:name",
      "destination": "/card.html"
    },
    {
      "source": "/card",
      "destination": "/card.html"
    },
    {
      "source": "/int",
      "destination": "/int.html"
    }
  ],
  "functions": {
    "api/query_swimmer.py": {
      "includeFiles": "data_buckets/**",
      "excludeFiles": "static/db_parts/**"
    },
    "api/*.py": {
      "excludeFiles": "static/db_parts/**"
    }
  }
}
