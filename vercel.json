{
  "headers": [
    {
      "source": "/(.*\\.html|/)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/256split",
      "destination": "/256split.html"
    }
  ],
  "functions": {
    "api/query_swimmer.py": {
      "includeFiles": "data_buckets/**",
      "excludeFiles": "static/db_parts/**"
    },
    "api/*.py": {
      "excludeFiles": "static/db_parts/**"
    }
  }
}
